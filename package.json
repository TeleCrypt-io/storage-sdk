{
  "name": "@telecrypt-io/storage",
  "version": "0.5.21",
  "license": "BUSL-1.1",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "synapse:up": "./throwaway_synapse/up.sh",
    "synapse:fresh": "./throwaway_synapse/up.sh --fresh",
    "synapse:down": "./throwaway_synapse/down.sh"
  },
  "dependencies": {
    "matrix-encrypt-attachment": "1.0.3",
    "matrix-js-sdk": "42.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.9.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeleCrypt-io/storage-sdk.git"
  },
  "homepage": "https://github.com/TeleCrypt-io/storage-sdk#readme",
  "bugs": {
    "url": "https://github.com/TeleCrypt-io/storage-sdk/issues"
  }
}
