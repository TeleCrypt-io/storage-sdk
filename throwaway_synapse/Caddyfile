# Front door for the throwaway MAS-delegated Synapse stack. The homeserver
# origin serves Matrix and MAS native endpoints from one origin.
# See https://element-hq.github.io/matrix-authentication-service/setup/homeserver.html
{
	servers :8008 {
		protocols h1
	}
}

:8008 {
	@mas_compat path /_matrix/client/*/logout /_matrix/client/*/refresh
	handle @mas_compat {
		reverse_proxy throwaway-mas:8080
	}

	@matrix path /_matrix/*
	handle @matrix {
		reverse_proxy throwaway-synapse:7608
	}

	# MAS owns its native root, OAuth and account routes.
	handle {
		reverse_proxy throwaway-mas:8080
	}
}
